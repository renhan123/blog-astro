---
import '../styles/global.css';
import Analytics from '@vercel/analytics/astro';
import { getDefaultOgImage } from '../utils';

interface Props {
  title?: string;
  description?: string;
  currentPath?: string;
  ogImage?: string;
  ogImageAlt?: string;
}

const {
  title = 'CodeEcho - 沉淀技术实践，构建个人知识库',
  description = '记录后端开发、工程实践与 AI 探索，把真实经验持续沉淀下来。',
  currentPath = '/',
  ogImage,
  ogImageAlt,
} = Astro.props;

const siteUrl = Astro.site ?? new URL('https://echocode.com.cn');
const canonicalUrl = new URL(Astro.url.pathname, siteUrl);
const ogType = currentPath.startsWith('/blog') ? 'article' : 'website';
const shareImage = ogImage ? new URL(ogImage, siteUrl).toString() : getDefaultOgImage(siteUrl);
const shareImageAlt = ogImageAlt ?? title;
---

<!doctype html>
<html lang="zh-CN" data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl.toString()} />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="CodeEcho" />
    <meta property="og:locale" content="zh_CN" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl.toString()} />
    <meta property="og:image" content={shareImage} />
    <meta property="og:image:alt" content={shareImageAlt} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={shareImage} />
    <meta name="twitter:image:alt" content={shareImageAlt} />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/prism/1.29.0/themes/prism-tomorrow.min.css" />
    <link rel="alternate" type="application/rss+xml" title="CodeEcho RSS" href="/rss.xml" />
    <script is:inline>
      (() => {
        const saved = localStorage.getItem('blog-theme');
        const theme = saved || (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
        document.documentElement.setAttribute('data-theme', theme);
      })();
    </script>
  </head>
  <body>
    <div class="reading-progress" id="readingProgress"></div>

    <nav class="navbar" id="navbar">
      <div class="nav-container">
        <a href="/" class="nav-logo">
          <span class="logo-icon">⌘</span>
          <span class="logo-text">CodeEcho</span>
        </a>
        <div class="nav-links">
          <a href="/" class:list={["nav-link", currentPath === '/' && 'active']}>首页</a>
          <a href="/assistant/" class:list={["nav-link", currentPath.startsWith('/assistant') && 'active']}>助手</a>
          <a href="/featured/" class:list={["nav-link", currentPath.startsWith('/featured') && 'active']}>推荐</a>
          <a href="/tags/" class:list={["nav-link", currentPath.startsWith('/tags') && 'active']}>标签</a>
          <a href="/series/" class:list={["nav-link", currentPath.startsWith('/series') && 'active']}>系列</a>
          <a href="/archive/" class:list={["nav-link", currentPath.startsWith('/archive') && 'active']}>归档</a>
          <a href="/about/" class:list={["nav-link", currentPath.startsWith('/about') && 'active']}>关于</a>
          <button class="nav-link nav-rss" id="rssToggle" title="RSS 订阅" aria-label="RSS 订阅">
            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M4 11a9 9 0 0 1 9 9"></path>
              <path d="M4 4a16 16 0 0 1 16 16"></path>
              <circle cx="5" cy="19" r="1" fill="currentColor" stroke="none"></circle>
            </svg>
          </button>
          <button class="theme-toggle" id="themeToggle" aria-label="切换主题">
            <svg class="icon-sun" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="12" cy="12" r="5"></circle>
              <line x1="12" y1="1" x2="12" y2="3"></line>
              <line x1="12" y1="21" x2="12" y2="23"></line>
              <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
              <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
              <line x1="1" y1="12" x2="3" y2="12"></line>
              <line x1="21" y1="12" x2="23" y2="12"></line>
              <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
              <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
            </svg>
            <svg class="icon-moon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
            </svg>
          </button>
        </div>
      </div>
    </nav>

    <main>
      <slot />
    </main>

    <footer class="footer">
      <div class="container">
        <p>© 2026 CodeEcho · 用代码记录思考 · Built with ❤️</p>
      </div>
    </footer>

    <button class="back-to-top" id="backToTop" aria-label="回到顶部">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
        <polyline points="18 15 12 9 6 15"></polyline>
      </svg>
    </button>

    <!-- RSS 订阅弹窗 -->
    <div class="rss-modal-overlay" id="rssModalOverlay"></div>
    <div class="rss-modal" id="rssModal">
      <button class="rss-modal-close" id="rssModalClose" aria-label="关闭">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
      <div class="rss-modal-header">
        <div class="rss-modal-icon">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="currentColor">
            <path d="M6.503 20.752c0 1.794-1.456 3.248-3.251 3.248-1.796 0-3.252-1.454-3.252-3.248 0-1.794 1.456-3.248 3.252-3.248 1.795.001 3.251 1.454 3.251 3.248zm-6.503-12.572v4.811c6.05.062 10.96 4.966 11.022 11.009h4.817c-.062-8.71-7.118-15.758-15.839-15.82zm0-3.368c10.58.046 19.152 8.594 19.183 19.188h4.817c-.03-13.231-10.739-23.954-24-24v4.812z"/>
          </svg>
        </div>
        <h3 class="rss-modal-title">RSS 订阅</h3>
        <p class="rss-modal-desc">将以下链接复制到你的 RSS 阅读器（如 Feedly、Inoreader、Reeder）中即可订阅博客更新。</p>
      </div>
      <div class="rss-modal-body">
        <div class="rss-modal-input-group">
          <input type="text" class="rss-modal-input" id="rssModalInput" value="" readonly />
          <button class="rss-modal-copy-btn" id="rssModalCopyBtn">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
              <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
            </svg>
            <span>复制</span>
          </button>
        </div>
        <span class="rss-modal-toast" id="rssModalToast">链接已复制！</span>
      </div>
    </div>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/prism/1.29.0/prism.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/prism/1.29.0/components/prism-go.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/prism/1.29.0/components/prism-java.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/prism/1.29.0/components/prism-sql.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/prism/1.29.0/components/prism-bash.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/prism/1.29.0/components/prism-yaml.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/prism/1.29.0/components/prism-json.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/prism/1.29.0/components/prism-protobuf.min.js"></script>
    <Analytics />

    <script is:inline>
      const themeToggle = document.getElementById('themeToggle');
      const backToTop = document.getElementById('backToTop');
      const readingProgress = document.getElementById('readingProgress');
      const navbar = document.getElementById('navbar');
      const tocLinks = [...document.querySelectorAll('.toc-nav a')];
      const articleBody = document.querySelector('.article-body');

      if (themeToggle) {
        themeToggle.addEventListener('click', () => {
          const current = document.documentElement.getAttribute('data-theme');
          const next = current === 'dark' ? 'light' : 'dark';
          document.documentElement.setAttribute('data-theme', next);
          localStorage.setItem('blog-theme', next);
        });
      }

      // RSS 弹窗
      const rssToggle = document.getElementById('rssToggle');
      const rssModal = document.getElementById('rssModal');
      const rssModalOverlay = document.getElementById('rssModalOverlay');
      const rssModalClose = document.getElementById('rssModalClose');
      const rssModalInput = document.getElementById('rssModalInput');
      const rssModalCopyBtn = document.getElementById('rssModalCopyBtn');
      const rssModalToast = document.getElementById('rssModalToast');

      function openRssModal() {
        if (rssModalInput) rssModalInput.value = window.location.origin + '/rss.xml';
        if (rssModal) rssModal.classList.add('active');
        if (rssModalOverlay) rssModalOverlay.classList.add('active');
        document.body.style.overflow = 'hidden';
      }

      function closeRssModal() {
        if (rssModal) rssModal.classList.remove('active');
        if (rssModalOverlay) rssModalOverlay.classList.remove('active');
        document.body.style.overflow = '';
      }

      if (rssToggle) rssToggle.addEventListener('click', openRssModal);
      if (rssModalClose) rssModalClose.addEventListener('click', closeRssModal);
      if (rssModalOverlay) rssModalOverlay.addEventListener('click', closeRssModal);

      if (rssModalCopyBtn && rssModalInput) {
        rssModalCopyBtn.addEventListener('click', () => {
          navigator.clipboard.writeText(rssModalInput.value).then(() => {
            if (rssModalToast) {
              rssModalToast.classList.add('show');
              setTimeout(() => rssModalToast.classList.remove('show'), 2000);
            }
          });
        });
      }

      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') closeRssModal();
      });

      if (tocLinks.length > 0) {
        tocLinks.forEach((link) => {
          link.addEventListener('click', (e) => {
            e.preventDefault();
            const id = link.getAttribute('href')?.slice(1);
            const target = id ? document.getElementById(id) : null;
            if (target) {
              const offset = 90;
              const top = target.getBoundingClientRect().top + window.scrollY - offset;
              window.scrollTo({ top, behavior: 'smooth' });
            }
          });
        });

        const headings = [...document.querySelectorAll('.article-body h2, .article-body h3')];
        if (headings.length > 0) {
          const observer = new IntersectionObserver((entries) => {
            const visible = entries.filter((entry) => entry.isIntersecting).sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top);
            if (visible[0]) {
              const activeId = visible[0].target.id;
              tocLinks.forEach((link) => link.classList.toggle('active', link.getAttribute('href') === '#' + activeId));
            }
          }, { rootMargin: '-80px 0px -60% 0px', threshold: 0 });

          headings.forEach((heading) => observer.observe(heading));
        }
      }

      window.addEventListener('scroll', () => {
        const scrollY = window.scrollY;
        const docHeight = document.documentElement.scrollHeight - window.innerHeight;

        if (articleBody && readingProgress && docHeight > 0) {
          const percent = Math.min(100, Math.round((scrollY / docHeight) * 100));
          readingProgress.style.width = percent + '%';
        } else if (readingProgress) {
          readingProgress.style.width = '0%';
        }

        if (backToTop) {
          backToTop.classList.toggle('visible', scrollY > 500);
        }

        if (navbar) {
          navbar.style.boxShadow = scrollY > 20 ? 'var(--shadow-sm)' : 'none';
        }
      });

      if (backToTop) {
        backToTop.addEventListener('click', () => {
          window.scrollTo({ top: 0, behavior: 'smooth' });
        });
      }
    </script>
  </body>
</html>
