---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="关于 - DevBlog" currentPath="/about/">
  <section class="view-about">
    <div class="about-container">
      <div class="about-card">
        <div class="about-avatar">👨‍💻</div>
        <h1 class="about-name">天才程序员</h1>
        <p class="about-title">全栈开发工程师</p>
        <p class="about-bio">
          热爱技术的开发者，专注于后端架构设计与工程实践。
          善于将复杂问题拆解为可落地的方案，相信好的代码不仅功能正确，更要可读、可维护。
          这个博客会持续记录我在后端、数据库、工程效率、AI 辅助开发等方向上的思考与实践。
        </p>
        <div class="about-skills">
          <h3>技术栈</h3>
          <div class="skill-tags">
            <span class="skill-tag">Java</span>
            <span class="skill-tag">Go</span>
            <span class="skill-tag">Python</span>
            <span class="skill-tag">JavaScript/TypeScript</span>
            <span class="skill-tag">Docker</span>
            <span class="skill-tag">Kubernetes</span>
            <span class="skill-tag">MySQL</span>
            <span class="skill-tag">Redis</span>
            <span class="skill-tag">Kafka</span>
            <span class="skill-tag">AI Coding</span>
          </div>
        </div>
        <div class="about-links">
          <a href="/" class="about-link-button">← 返回首页</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
