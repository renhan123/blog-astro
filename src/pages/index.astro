---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime()
);


const seriesEntries = [
  {
    key: 'ai-engineering',
    title: 'AI + 工程实践',
    description: '记录 AI 在日常开发、Agent 工程化和效率提升中的真实使用与实践沉淀。',
    href: '/series/#ai-engineering',
    count: posts.reduce((total, post) => total + (post.data.series === 'ai-engineering' ? 1 : 0), 0),
  },
  {
    key: 'backend-practice',
    title: '后端技术沉淀',
    description: '围绕数据库、缓存、部署、并发、架构等后端核心问题持续沉淀。',
    href: '/series/#backend-practice',
    count: posts.reduce((total, post) => total + (post.data.series === 'backend-practice' ? 1 : 0), 0),
  },
  {
    key: 'growth-methodology',
    title: '个人成长 / 工程方法论',
    description: '记录知识沉淀、学习方法、工程思维以及从做事到抽象方法的过程。',
    href: '/series/#growth-methodology',
    count: posts.reduce((total, post) => total + (post.data.series === 'growth-methodology' ? 1 : 0), 0),
  },
];
---

<BaseLayout
  title="CodeEcho - 沉淀技术实践，构建个人知识库"
  description="记录后端开发、工程实践与 AI 探索，把真实经验持续沉淀下来。"
  currentPath="/"
>
  <section class="hero">
    <div class="hero-content">
      <h1 class="hero-title">沉淀技术实践，构建个人知识库</h1>
      <p class="hero-subtitle">记录后端开发、工程实践与 AI 探索，把真实经验持续沉淀下来。</p>
    </div>
  </section>

  <div class="container home-main">
    <section class="home-topic-nav" aria-label="内容方向导航">
      <div class="home-topic-nav-header">
        <span class="home-topic-nav-kicker">内容方向导航</span>
        <p class="home-topic-nav-desc">先按方向快速浏览，完整文章仍在下方列表中。</p>
      </div>
      <div class="topic-nav-list">
        {seriesEntries.map((series) => (
          <a href={series.href} class="topic-nav-item">
            <div class="topic-nav-top">
              <h3 class="topic-nav-title">{series.title}</h3>
              <span class="topic-nav-count">{series.count > 0 ? String(series.count) + ' 篇' : '规划中'}</span>
            </div>
            <p class="topic-nav-desc">{series.description}</p>
            <span class="topic-nav-link">进入系列 →</span>
          </a>
        ))}
      </div>
    </section>

    <div class="search-box" id="searchBox">
      <svg class="search-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <circle cx="11" cy="11" r="8"></circle>
        <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
      </svg>
      <input type="text" id="searchInput" placeholder="搜索文章标题或内容..." autocomplete="off" />
      <button class="search-shortcut" id="searchShortcut" title="搜索 (Ctrl+K)" aria-label="搜索">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="11" cy="11" r="8"></circle>
          <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
        </svg>
      </button>
    </div>

    <div class="filter-bar" id="filterBar">
      <button class="filter-btn active" data-category="all">全部</button>
      <button class="filter-btn" data-category="backend">后端</button>
      <button class="filter-btn" data-category="frontend">前端</button>
      <button class="filter-btn" data-category="devops">DevOps</button>
      <button class="filter-btn" data-category="database">数据库</button>
    </div>

    <div class="article-grid" id="articleGrid">
      {posts.map((post, index) => <ArticleCard post={post} delay={Math.min((index + 1) * 0.05, 0.3)} />)}
    </div>
  </div>

  <script is:inline>
    const input = document.getElementById('searchInput');
    const buttons = [...document.querySelectorAll('.filter-btn')];
    const cards = [...document.querySelectorAll('.article-card')];
    const counts = { all: cards.length };

    cards.forEach((card) => {
      const category = card.dataset.category;
      counts[category] = (counts[category] || 0) + 1;
    });

    // 保存原始标题和摘要文本用于高亮恢复
    cards.forEach((card) => {
      const titleEl = card.querySelector('.card-title');
      const excerptEl = card.querySelector('.card-excerpt');
      if (titleEl && !titleEl.dataset.original) titleEl.dataset.original = titleEl.textContent;
      if (excerptEl && !excerptEl.dataset.original) excerptEl.dataset.original = excerptEl.textContent;
    });

    buttons.forEach((button) => {
      const baseText = button.textContent?.trim() || '';
      button.innerHTML = baseText + ' <span style="opacity:0.6;margin-left:2px;">' + (counts[button.dataset.category] || 0) + '</span>';
    });

    let currentCategory = 'all';
    let currentQuery = '';

    function highlightText(element, query) {
      if (!query) {
        element.innerHTML = element.dataset.original;
        return;
      }
      const text = element.dataset.original;
      const regex = new RegExp('(' + query.replace(/[.*+?^${}()|[\]\\]/g, '\\$&') + ')', 'gi');
      element.innerHTML = text.replace(regex, '<mark class="search-highlight">$1</mark>');
    }

    function applyFilters() {
      let visibleCount = 0;
      cards.forEach((card) => {
        const categoryMatch = currentCategory === 'all' || card.dataset.category === currentCategory;
        const searchText = card.dataset.search || '';
        const queryMatch = !currentQuery || searchText.includes(currentQuery);
        const visible = categoryMatch && queryMatch;
        card.style.display = visible ? 'flex' : 'none';

        // 高亮匹配的关键词
        const titleEl = card.querySelector('.card-title');
        const excerptEl = card.querySelector('.card-excerpt');
        if (visible && titleEl) highlightText(titleEl, currentQuery);
        if (visible && excerptEl) highlightText(excerptEl, currentQuery);
        if (!visible) {
          if (titleEl) titleEl.innerHTML = titleEl.dataset.original;
          if (excerptEl) excerptEl.innerHTML = excerptEl.dataset.original;
        }

        if (visible) visibleCount += 1;
      });

      let empty = document.querySelector('.no-results');
      if (visibleCount === 0) {
        if (!empty) {
          empty = document.createElement('div');
          empty.className = 'no-results';
          empty.innerHTML = '<div class="no-results-icon">🔍</div><p>没有找到匹配的文章</p>';
          document.getElementById('articleGrid')?.appendChild(empty);
        }
      } else if (empty) {
        empty.remove();
      }
    }

    buttons.forEach((button) => {
      button.addEventListener('click', () => {
        buttons.forEach((item) => item.classList.remove('active'));
        button.classList.add('active');
        currentCategory = button.dataset.category || 'all';
        applyFilters();
      });
    });

    const searchShortcut = document.getElementById('searchShortcut');
    if (searchShortcut && input) {
      searchShortcut.addEventListener('click', () => {
        input.focus();
      });
    }

    if (input) {
      input.addEventListener('input', () => {
        currentQuery = input.value.trim().toLowerCase();
        applyFilters();
      });

      document.addEventListener('keydown', (event) => {
        if ((event.ctrlKey || event.metaKey) && event.key.toLowerCase() === 'k') {
          event.preventDefault();
          input.focus();
        }
        if (event.key === 'Escape' && document.activeElement === input) {
          input.value = '';
          currentQuery = '';
          input.blur();
          applyFilters();
        }
      });
    }
  </script>
</BaseLayout>
