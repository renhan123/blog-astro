---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getEntrySlug, translationLevelLabels } from '../../utils';

const translationArticles = (await getCollection('translation')).sort((a, b) => {
  const aDate = a.data.publishedAt?.getTime() ?? 0;
  const bDate = b.data.publishedAt?.getTime() ?? 0;
  return bDate - aDate;
});

// Prefer the exam year in the filename; the publication date is a fallback for other articles.
const articlesByYear = new Map<string, typeof translationArticles>();
for (const article of translationArticles) {
  const year = getEntrySlug(article.id).match(/^(20[0-9]{2})-reading-text-/)?.[1]
    ?? (article.data.publishedAt ? String(article.data.publishedAt.getFullYear()) : '其他');
  if (!articlesByYear.has(year)) articlesByYear.set(year, []);
  articlesByYear.get(year)!.push(article);
}
const yearGroups = [...articlesByYear.entries()]
  .sort(([a], [b]) => b.localeCompare(a, 'zh-CN', { numeric: true }))
  .map(([year, articles]) => [
    year,
    articles.sort((a, b) => getEntrySlug(a.id).localeCompare(getEntrySlug(b.id), 'zh-CN', { numeric: true })),
  ] as const);

const progressIndexPayload = translationArticles.map((article) => ({
  slug: getEntrySlug(article.id),
  sentenceCount: article.data.sentences.length,
}));
---

<BaseLayout
  title="翻译导航 - CodeEcho"
  description="面向英文技术文章的逐句翻译导航模块：先自己翻，再查看系统参考译文。"
  currentPath="/translator/"
>
  <section class="translation-index-view">
    <div class="container translation-index-shell">
      <section class="translation-index-hero">
        <div class="translation-index-hero-main">
          <span class="translation-index-kicker">Translation Lab</span>
          <h1 class="translation-index-title">逐句翻译导航</h1>
          <p class="translation-index-desc">
            这里不是“直接看机器翻译”，而是一个更适合练习英文技术文章精读的翻译空间：
            <strong>先自己写，再看系统参考译文</strong>。
          </p>
          <div class="translation-index-pills">
            <span class="translation-index-pill">逐句拆解文章</span>
            <span class="translation-index-pill">本地自动保存</span>
            <span class="translation-index-pill">写完再看参考译文</span>
          </div>
        </div>
        <div class="translation-index-hero-side">
          <div class="translation-index-highlight-card">
            <h2>适合这样使用</h2>
            <ol>
              <li>先选择一篇英文文章进入逐句翻译页</li>
              <li>在每个翻译框中写出你自己的中文理解</li>
              <li>输入后再展开参考译文，逐句比对和修正</li>
            </ol>
          </div>
        </div>
      </section>

      <section class="translation-index-meta-grid">
        <div class="translation-index-meta-card">
          <strong>{translationArticles.length}</strong>
          <span>篇可练习文章</span>
        </div>
        <div class="translation-index-meta-card">
          <strong>{translationArticles.reduce((sum, article) => sum + article.data.sentences.length, 0)}</strong>
          <span>句英文原文</span>
        </div>
        <div class="translation-index-meta-card">
          <strong>自我作答</strong>
          <span>先翻译，再揭晓</span>
        </div>
      </section>

      <section class="translation-index-list-section">
        <div class="translation-index-section-head">
          <div>
            <span class="translation-index-section-kicker">文章导航</span>
            <h2 class="translation-index-section-title">按年份选择真题</h2>
          </div>
          <p class="translation-index-section-desc">点击年份展开文章列表；练习进度会保存在当前浏览器中。</p>
        </div>

        <div class="translation-year-list">
          {yearGroups.map(([year, articles]) => (
            <details class="translation-year-group">
              <summary class="translation-year-summary">
                <span class="translation-year-name">{year === "其他" ? "其他文章" : year + " 年真题"}</span>
                <span class="translation-year-count">{articles.length} 篇文章</span>
                <span class="translation-year-chevron" aria-hidden="true">⌄</span>
              </summary>
              <div class="translation-year-articles">
                {articles.map((article) => {
                  const slug = getEntrySlug(article.id);
                  const sentenceCount = article.data.sentences.length;
                  return (
                    <article class="translation-article-row" data-translation-card data-slug={slug} data-sentence-count={sentenceCount}>
                      <div class="translation-article-main">
                        <h3 class="translation-article-title">{article.data.title}</h3>
                        <p class="translation-article-desc">{article.data.description}</p>
                        <span class="translation-article-meta">{translationLevelLabels[article.data.level] ?? article.data.level} · {sentenceCount} 句</span>
                      </div>
                      <div class="translation-article-actions">
                        <div class="translation-index-progress-block">
                          <div class="translation-index-progress-top"><span>当前进度</span><strong data-progress-text>未开始</strong></div>
                          <div class="translation-index-progress-track"><span data-progress-bar style="width: 0%;"></span></div>
                        </div>
                        <a class="translation-index-enter" href={"/translator/" + slug + "/"} aria-label={"进入 " + article.data.title + " 逐句翻译"}>开始翻译 →</a>
                      </div>
                    </article>
                  );
                })}
              </div>
            </details>
          ))}
        </div>
      </section>
    </div>
  </section>

  <style is:global>
    .translation-index-view { margin-top: var(--nav-height); padding: 42px 0 88px; }
    .translation-index-shell { max-width: 1200px; }
    .translation-index-hero { display: grid; grid-template-columns: minmax(0, 1.45fr) minmax(320px, 0.95fr); gap: 24px; align-items: stretch; margin-bottom: 26px; }
    .translation-index-hero-main,
    .translation-index-highlight-card,
    .translation-index-meta-card,
    .translation-year-group { background: var(--bg-card); border: 1px solid var(--border-color); box-shadow: var(--shadow-sm); }
    .translation-index-hero-main { border-radius: 28px; padding: 34px 34px 32px; background: linear-gradient(135deg, rgba(99,102,241,0.12), rgba(168,85,247,0.08) 55%, rgba(255,255,255,0.02)); }
    .translation-index-kicker,
    .translation-index-section-kicker,
    .translation-index-note-label { display: inline-block; font-size: 0.76rem; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: var(--accent); }
    .translation-index-title { font-size: 2.35rem; line-height: 1.15; margin: 16px 0 14px; }
    .translation-index-desc { color: var(--text-secondary); font-size: 1rem; line-height: 1.9; max-width: 720px; }
    .translation-index-pills { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 24px; }
    .translation-index-pill { display: inline-flex; align-items: center; padding: 8px 14px; border-radius: 999px; border: 1px solid rgba(99,102,241,0.16); background: rgba(99,102,241,0.08); color: var(--accent); font-size: 0.84rem; font-weight: 600; }
    .translation-index-highlight-card { border-radius: 28px; padding: 28px; height: 100%; }
    .translation-index-highlight-card h2 { font-size: 1.08rem; margin-bottom: 16px; }
    .translation-index-highlight-card ol { padding-left: 20px; display: grid; gap: 12px; color: var(--text-secondary); line-height: 1.9; }
    .translation-index-meta-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; margin-bottom: 28px; }
    .translation-index-meta-card { border-radius: 22px; padding: 22px 20px; text-align: center; }
    .translation-index-meta-card strong { display: block; font-size: 1.4rem; line-height: 1.2; margin-bottom: 6px; }
    .translation-index-meta-card span { color: var(--text-secondary); font-size: 0.88rem; }
    .translation-index-list-section { display: grid; gap: 18px; }
    .translation-index-section-head { display: flex; justify-content: space-between; gap: 24px; align-items: end; flex-wrap: wrap; }
    .translation-index-section-title { font-size: 1.55rem; margin-top: 10px; }
    .translation-index-section-desc { color: var(--text-secondary); max-width: 520px; line-height: 1.8; }
    .translation-year-list { display: grid; gap: 16px; }
    .translation-year-group { border-radius: 22px; overflow: hidden; }
    .translation-year-group[open] { border-color: rgba(99,102,241,0.26); }
    .translation-year-summary { display: flex; align-items: center; gap: 14px; padding: 22px 26px; cursor: pointer; list-style: none; }
    .translation-year-summary::-webkit-details-marker { display: none; }
    .translation-year-summary:hover { background: var(--bg-secondary); }
    .translation-year-name { font-size: 1.2rem; font-weight: 700; }
    .translation-year-count { margin-left: auto; color: var(--text-secondary); font-size: 0.88rem; }
    .translation-year-chevron { color: var(--accent); font-size: 1.4rem; line-height: 1; transition: transform var(--transition); }
    .translation-year-group[open] .translation-year-chevron { transform: rotate(180deg); }
    .translation-year-articles { border-top: 1px solid var(--border-color); }
    .translation-article-row { display: flex; align-items: center; justify-content: space-between; gap: 28px; padding: 20px 26px; }
    .translation-article-row + .translation-article-row { border-top: 1px solid var(--border-color); }
    .translation-article-row:hover { background: var(--bg-secondary); }
    .translation-article-main { flex: 1; min-width: 0; }
    .translation-article-title { font-size: 1.04rem; line-height: 1.5; }
    .translation-article-desc { color: var(--text-secondary); font-size: 0.86rem; line-height: 1.6; margin-top: 5px; }
    .translation-article-meta { display: block; color: var(--text-muted); font-size: 0.8rem; margin-top: 8px; }
    .translation-article-actions { display: flex; align-items: center; gap: 18px; width: min(100%, 320px); flex-shrink: 0; }
    .translation-index-progress-top { display: flex; align-items: center; justify-content: space-between; gap: 12px; }
    .translation-index-progress-block { flex: 1; min-width: 0; }
    .translation-index-progress-top span { color: var(--text-muted); font-size: 0.8rem; }
    .translation-index-progress-top strong { color: var(--text-primary); font-size: 0.88rem; }
    .translation-index-progress-track { margin-top: 10px; height: 8px; border-radius: 999px; background: var(--bg-secondary); overflow: hidden; }
    .translation-index-progress-track span { display: block; height: 100%; border-radius: inherit; background: linear-gradient(90deg, var(--accent), #8b5cf6); }
    .translation-index-enter { display: inline-flex; align-items: center; gap: 10px; white-space: nowrap; padding: 11px 16px; border-radius: 999px; background: linear-gradient(135deg, var(--accent), #8b5cf6); color: #fff; font-size: 0.9rem; font-weight: 700; }
    .translation-index-enter:hover { color: #fff; filter: brightness(1.05); }
    @media (max-width: 960px) {
      .translation-index-hero { grid-template-columns: 1fr; }
      .translation-index-meta-grid { grid-template-columns: 1fr; }
    }
    @media (max-width: 640px) {
      .translation-index-view { padding: 30px 0 60px; }
      .translation-index-hero-main,
      .translation-index-highlight-card { border-radius: 22px; padding: 22px 18px; }
      .translation-index-title { font-size: 1.85rem; }
      .translation-year-summary, .translation-article-row { padding: 18px; }
      .translation-article-row, .translation-article-actions { flex-direction: column; align-items: stretch; }
      .translation-article-actions { width: 100%; gap: 14px; }
      .translation-index-enter { justify-content: center; }
    }
  </style>

  <script type="application/json" id="translationIndexProgressData" set:html={JSON.stringify(progressIndexPayload)}></script>
  <script is:inline>
    (() => {
      const dataNode = document.getElementById('translationIndexProgressData');
      if (!dataNode) return;

      let payload = [];
      try {
        payload = JSON.parse(dataNode.textContent || '[]');
      } catch (error) {
        return;
      }

      const progressMap = new Map(payload.map((item) => [item.slug, item.sentenceCount]));
      const cards = Array.from(document.querySelectorAll('[data-translation-card]'));

      cards.forEach((card) => {
        const slug = card.getAttribute('data-slug') || '';
        const sentenceCount = Number(card.getAttribute('data-sentence-count') || progressMap.get(slug) || 0);
        const progressText = card.querySelector('[data-progress-text]');
        const progressBar = card.querySelector('[data-progress-bar]');
        if (!slug || !sentenceCount || !progressText || !progressBar) return;

        const saved = localStorage.getItem('translation-lab:' + slug);
        let filledCount = 0;

        if (saved) {
          try {
            const parsed = JSON.parse(saved);
            const entries = parsed?.entries || {};
            filledCount = Object.values(entries).filter((item) => item && typeof item === 'object' && String(item.draft || '').trim()).length;
          } catch (error) {
            filledCount = 0;
          }
        }

        const percent = sentenceCount > 0 ? Math.round((filledCount / sentenceCount) * 100) : 0;
        progressText.textContent = filledCount > 0 ? filledCount + ' / ' + sentenceCount + ' 句已完成' : '未开始';
        progressBar.style.width = percent + '%';
      });
    })();
  </script>
</BaseLayout>
